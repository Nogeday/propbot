//@version=5
// =====================================================================================
//  MTF TREND CONTINUATION — 5m execution / 1H trend filter   (S&P 500: SPY / ES / SPX*)
// -------------------------------------------------------------------------------------
//  Run this on a 5-MINUTE chart. The 1-Hour trend bias is pulled with request.security on
//  the PREVIOUS 1H bar ([1]) with lookahead = barmerge.lookahead_on => history AND realtime
//  both see only the last CLOSED 1H bar. (lookahead_off without [1] returns the still-forming
//  1H value on realtime bars, so live signals would differ from the backtest.) Expected side
//  effect: the HTF filter lags by one 1H bar. Combined with calc_on_every_tick = false
//  (closed-bar evaluation) and market orders that fill at the NEXT bar's open, the system
//  is non-repainting.
// -------------------------------------------------------------------------------------
//  CORE LOGIC
//   1. HTF TREND ALIGNMENT : 1H EMA20 > 1H EMA50  -> long bias ;  < -> short bias.
//   2. VALUE-AREA PULLBACK : on the 5m chart price retraces into the band between the
//      5m EMA21 and 5m EMA50 (the bar's range must intersect the band).
//   3. VOLUME DRY-UP       : during that pullback bar, volume < its 20-period average
//      (counter-trend pressure is fading). *SPX has no real volume — use SPY/ES or
//      disable this filter.
//   4. MOMENTUM TRIGGER    : once "armed" (steps 1-3 met), enter on the first strong
//      candle that closes in the trend direction and beyond the prior bar's extreme
//      (long: bullish close AND close > high[1] ; short mirrored).
// -------------------------------------------------------------------------------------
//  TRADE MANAGEMENT (prop-firm)
//   • SIZING       : fixed % of the risk base (Initial Capital by default) -> qty = (base*risk%) / (stopDist*pointValue)
//   • INITIAL STOP : just beyond the recent 5m swing low/high (+ buffer).
//   • SCALE-OUT    : close 50% (configurable) at 1.5R, then move the runner's stop to
//                    BREAKEVEN, then trail it with a Chandelier Exit OR a 14-ATR stop.
//                    After the breakeven move the trail advances only in steps of >= N ticks (default 4).
//   • PLAN B       : if integer sizing yields an ODD / 1-contract position (no clean
//                    50/50 split for futures), the scale-out is skipped and the FULL
//                    position is run as the runner (initial stop until 1.5R, then BE+trail).
//   • CIRCUIT      : max trades/day, daily-loss halt, optional consecutive-loss halt,
//                    optional session window + EOD flat, backtest date range + OOS split.
//   • TABLE        : runner / strategy performance (TP1 reach %, runner win %, avg R...),
//                    with an All / In-Sample / Out-of-Sample scope.
//  DEFAULTS ARE TUNED FOR MES (Micro E-mini S&P 500):
//    Commission = cash per contract, $0.50 / side  =>  $1.00 round-turn.
//    Slippage   = 1 tick  (MES tick = 0.25 index points = $1.25 / contract).
//  For other instruments, change these in the strategy's "Properties" tab
//    (full-size ES -> higher cash per contract ; SPY -> % of value, & enable volume).
//    TradingView charges commission on EACH fill (entry and exit separately) and adds
//    slippage only to market and stop fills (never to limit fills such as TP1).
//    US500 CFD : Commission 0 unless the broker charges one · slippage = (spread / 2 +
//                expected slip) in ticks of the chart symbol (a round trip pays two fills).
//  WEBHOOK ALERTS: JSON via alert() (create the alert with "alert() function calls only").
// =====================================================================================

strategy(
     title              = "MTF Trend Continuation (5m / 1H)",
     shorttitle         = "MTF Trend Cont.",
     overlay            = true,
     pyramiding         = 0,
     initial_capital    = 10000,
     default_qty_type   = strategy.fixed,
     default_qty_value  = 1,
     commission_type    = strategy.commission.cash_per_contract,
     commission_value   = 0.50,   // MES default: $0.50 / side  =>  $1.00 round-turn (entry + exit)
     slippage           = 1,      // 1 tick (MES tick = 0.25 index pts = $1.25 / contract)
     calc_on_every_tick = false,
     max_boxes_count    = 200,
     max_lines_count    = 200,
     max_labels_count   = 200)

// =====================================================================================
//  INPUTS
// =====================================================================================
g_mtf    = "1) MTF / Trend (HTF)"
g_va     = "2) Value Area (LTF)"
g_vol    = "3) Volume Filter"
g_entry  = "4) Entry"
g_risk   = "5) Risk & Position Sizing"
g_scale  = "6) Scale-Out & Trailing"
g_limit  = "7) Daily Limits & Circuit Breakers"
g_sess   = "8) Session"
g_dates  = "9) Backtest Date Range / OOS"
g_vis    = "10) Visuals"
g_tbl    = "11) Performance Table"
g_alert  = "12) Alerts (webhook)"

tz = input.string("America/New_York", "Timezone", group = g_mtf, tooltip = "Used for day change, session window and weekday logic. Keep America/New_York for SPX/SPY/ES.")

// HTF trend
htfTf      = input.timeframe("60", "HTF timeframe", group = g_mtf, tooltip = "Higher timeframe for the trend filter. Default 60 = 1 Hour. Keep this STRICTLY above the chart timeframe.")
htfFastLen = input.int(20, "HTF fast EMA", minval = 1, group = g_mtf)
htfSlowLen = input.int(50, "HTF slow EMA", minval = 1, group = g_mtf)

// Value Area (LTF)
ltfFastLen = input.int(21, "5m fast EMA (Value Area top/bot)", minval = 1, group = g_va)
ltfSlowLen = input.int(50, "5m slow EMA (Value Area top/bot)", minval = 1, group = g_va)

// Volume
useVolFilter = input.bool(true, "Require volume below average in the pullback", group = g_vol, tooltip = "Drying-up of counter-trend volume. Turn OFF on SPX (index has no real volume).")
volLen       = input.int(20, "Volume average length", minval = 1, group = g_vol)

// Entry
allowLong       = input.bool(true,  "Allow longs",  group = g_entry)
allowShort      = input.bool(true,  "Allow shorts", group = g_entry)
armValidityBars = input.int(10, "Pullback validity (bars)", minval = 1, group = g_entry, tooltip = "After a valid pullback is detected, the momentum trigger must fire within this many 5m bars, or the setup expires.")

// Risk & sizing
riskPercent  = input.float(0.5, "Risk per trade (%)", minval = 0.01, step = 0.1, group = g_risk, tooltip = "Fixed-fractional risk. qty = (risk base * risk%) / (stopDistance * pointValue). 0.5% is a conservative prop-firm default.")
riskBase     = input.string("Initial Capital", "Risk base", options = ["Initial Capital", "Account Equity", "Fixed Balance"], group = g_risk, tooltip = "Balance the risk % is applied to. Initial Capital = the strategy's starting capital (Properties): fixed cash risk per trade, no compounding — the prop-firm rule (SPEC §8.1). Account Equity = current equity (compounds with wins and losses). Fixed Balance = the amount typed below.")
fixedBal     = input.float(10000, "Fixed balance ($)", minval = 1, group = g_risk, tooltip = "Used only when Risk base = Fixed Balance.")
swingLen     = input.int(10, "Swing lookback for initial stop (bars)", minval = 1, group = g_risk, tooltip = "Stop is placed beyond the lowest low / highest high of the last N bars (a proxy for the recent swing).")
swingBufTick = input.int(4, "Stop buffer beyond swing (ticks)", minval = 0, group = g_risk)
roundUnits   = input.bool(true, "Round position to whole units", group = g_risk, tooltip = "ON = integer contracts/shares. On futures (ES pointvalue 50) a small account can legitimately size to 0 contracts (correct, not a bug).")

// Scale-out & trail
tp1RR        = input.float(1.5, "TP1 reward : risk", minval = 0.1, step = 0.1, group = g_scale)
scaleOutPct  = input.float(50, "Scale-out % at TP1", minval = 1, maxval = 99, step = 1, group = g_scale, tooltip = "Portion closed at TP1; the rest becomes the runner. NOTE: futures need an EVEN contract count to split cleanly (1 contract cannot be halved live).")
trailType    = input.string("Chandelier Exit", "Runner trailing method", options = ["Chandelier Exit", "ATR Trailing"], group = g_scale)
chLen        = input.int(22, "Chandelier length (highest + ATR)", minval = 1, group = g_scale)
chMult       = input.float(3.0, "Chandelier ATR multiplier", minval = 0.1, step = 0.1, group = g_scale)
atrTrailLen  = input.int(14, "ATR trailing length", minval = 1, group = g_scale)
atrTrailMult = input.float(2.5, "ATR trailing multiplier", minval = 0.1, step = 0.1, group = g_scale)
trailMinStepTicks = input.int(4, "Min trail step (ticks)", minval = 1, group = g_scale, tooltip = "After the first move to breakeven, the runner stop (and its stop_update alert) only moves when the new level improves the current stop by at least this many ticks. Default 4 = trail_min_step_ticks in config/risk.yaml (request budget: at most one stop update per bar, in meaningful steps).")

// Daily limits & circuit breakers
maxTradesDay   = input.int(1, "Max trades per day", minval = 1, group = g_limit, tooltip = "Hard cap on new entries per NY calendar day to avoid overtrading chop. 1 = one trade per strategy per day (SPEC §3.1).")
useDailyLoss   = input.bool(true, "Daily-loss circuit breaker", group = g_limit)
dailyLossPct   = input.float(2.0, "Max daily loss (% of day-start equity)", minval = 0.1, step = 0.1, group = g_limit)
flatOnDailyLoss= input.bool(true, "Force flat when daily loss is hit", group = g_limit, tooltip = "Evaluated on bar close (no intrabar magnifier), so it approximates a real prop daily-loss breach.")
useConsec      = input.bool(false, "Consecutive-loss halt (resets daily)", group = g_limit)
maxConsec      = input.int(3, "Max consecutive losses", minval = 1, group = g_limit)

// Session
useSession = input.bool(true, "Restrict entries to a session window", group = g_sess)
sessStartH = input.int(9,  "Session start hour (24h)",  minval = 0, maxval = 23, group = g_sess)
sessStartM = input.int(30, "Session start minute",      minval = 0, maxval = 59, group = g_sess)
sessEndH   = input.int(15, "Session end hour (24h)",    minval = 0, maxval = 23, group = g_sess)
sessEndM   = input.int(55, "Session end minute",        minval = 0, maxval = 59, group = g_sess, tooltip = "No new entries whose fill bar would open at/after this time; if 'flat at end' is on, open trades are closed.")
flatAtEnd  = input.bool(true, "Flat at session end", group = g_sess)

// Backtest date range / OOS
startDate   = input.time(timestamp("01 Jan 2024 00:00 +0000"), "Start date", group = g_dates, tooltip = "Trades begin on/after this date.")
oosStart    = input.time(timestamp("01 Jan 2025 00:00 +0000"), "In-sample end / OOS start", group = g_dates, tooltip = "Boundary between optimization (IS) and unseen (OOS) data. The strategy keeps trading across it; it drives the chart marker and the table scope.")
endDate     = input.time(timestamp("01 Jan 2030 00:00 +0000"), "End date", group = g_dates)
showDateViz = input.bool(true, "Shade OOS / out-of-range region", group = g_dates)

// Visuals
showVA     = input.bool(true,  "Show 5m Value-Area band", group = g_vis)
showHtf    = input.bool(true,  "Show 1H EMAs (stepped)",  group = g_vis)
showLevels = input.bool(true,  "Show stop / TP lines",    group = g_vis)

// Performance table
showPerf  = input.bool(true, "Show performance table", group = g_tbl)
tableScope = input.string("All", "Table scope", options = ["All", "In-Sample", "Out-of-Sample"], group = g_tbl, tooltip = "Filter every figure in the table to in-sample or out-of-sample trades (by entry time vs. 'In-sample end / OOS start') to check whether the edge survives on unseen data.")
tablePos  = input.string("Bottom Right", "Table position", options = ["Bottom Right", "Top Right", "Bottom Left", "Top Left"], group = g_tbl)
tableSize = input.string("Small", "Table text size", options = ["Tiny", "Small", "Normal", "Large"], group = g_tbl)

// Alerts
alertToken = input.string("", "Webhook token", group = g_alert, tooltip = "Webhook-only random value (NOT a login or API key). Must match the receiver. Create ONE alert: condition = this strategy, 'alert() function calls only', webhook URL = receiver. Re-create the alert after changing any input.")

// =====================================================================================
//  MTF DATA  (non-repainting — see header)
// =====================================================================================
// EMAs are computed INSIDE the request on true 1H closes. [1] + lookahead_on = the last CLOSED
// 1H bar on history and realtime alike. The two go together: lookahead_on without [1] reads
// the future on history.
[htfFast, htfSlow] = request.security(syminfo.tickerid, htfTf,
     [ta.ema(close, htfFastLen)[1], ta.ema(close, htfSlowLen)[1]],
     lookahead = barmerge.lookahead_on)

htfBull = not na(htfFast) and not na(htfSlow) and htfFast > htfSlow
htfBear = not na(htfFast) and not na(htfSlow) and htfFast < htfSlow

// =====================================================================================
//  LOGIC
// =====================================================================================
// ---- Time / date / day ----
nyH    = hour(time, tz)
nyM    = minute(time, tz)
curMin = nyH * 60 + nyM
sStart = sessStartH * 60 + sessStartM
sEnd   = sessEndH   * 60 + sessEndM
sessionOK = not useSession or (curMin >= sStart and curMin < sEnd)
// Entry-time gate: a market entry fills at the NEXT bar's open, so the signal bar must not be
// the chart session's last bar (the fill would land in the next session) and, with the session
// window on, the fill bar must open before the session end.
barMin      = math.max(1, int(timeframe.in_seconds() / 60))    // chart bar length in minutes
entryTimeOK = not session.islastbar and (not useSession or curMin + barMin < sEnd)

newDay = ta.change(dayofmonth(time, tz)) != 0

inDateRange = time >= startDate and time <= endDate
isOOS       = time >= oosStart

// ---- LTF indicators (all ta.* at global scope for correct series) ----
emaFast = ta.ema(close, ltfFastLen)
emaSlow = ta.ema(close, ltfSlowLen)
vaTop   = math.max(emaFast, emaSlow)
vaBot   = math.min(emaFast, emaSlow)
inVA    = low <= vaTop and high >= vaBot          // bar range intersects the EMA band

volAvg  = ta.sma(volume, volLen)
volOK   = useVolFilter ? (not na(volAvg) and volume < volAvg) : true

swingLow  = ta.lowest(low,  swingLen)
swingHigh = ta.highest(high, swingLen)
buf       = swingBufTick * syminfo.mintick
trailMinStep = trailMinStepTicks * syminfo.mintick   // minimum trailing improvement, in price units

atrCh   = ta.atr(chLen)
atrTr   = ta.atr(atrTrailLen)
chLong  = ta.highest(high, chLen) - atrCh * chMult
chShort = ta.lowest(low,  chLen)  + atrCh * chMult
atrLong  = close - atrTr * atrTrailMult
atrShort = close + atrTr * atrTrailMult
trailLong  = trailType == "Chandelier Exit" ? chLong  : atrLong
trailShort = trailType == "Chandelier Exit" ? chShort : atrShort

// ---- Arm (pullback) + momentum trigger ----
var int armDir = 0     // 0 none, 1 long-armed, -1 short-armed
var int armBar = 0

if newDay
    armDir := 0        // do not carry an overnight setup into a new session

longPullback  = htfBull and inVA and volOK and allowLong
shortPullback = htfBear and inVA and volOK and allowShort

if longPullback
    armDir := 1
    armBar := bar_index
else if shortPullback
    armDir := -1
    armBar := bar_index

// invalidate the arm: trend flipped or setup got stale
if armDir == 1 and (not htfBull or (bar_index - armBar) > armValidityBars)
    armDir := 0
if armDir == -1 and (not htfBear or (bar_index - armBar) > armValidityBars)
    armDir := 0

bullTrigger = close > open and close > high[1]
bearTrigger = close < open and close < low[1]
longSignal  = armDir ==  1 and bullTrigger
shortSignal = armDir == -1 and bearTrigger

// ---- Webhook alert (JSON, schema v1 — docs/SPEC.md §5.1) ----
f_num(float x) => na(x) ? "null" : str.tostring(x, format.mintick)

f_alert(string action, string side, float estEntry, float stop, float tp) =>
    string j = '{"v":1,"token":"' + alertToken + '","strategy_id":"mtf_trend_cont"'
    j := j + ',"symbol":"' + syminfo.tickerid + '","tf":"' + timeframe.period + '","bar_time":' + str.tostring(time, "#")
    j := j + ',"action":"' + action + '","side":"' + side + '","setup":"MTF_PULLBACK","order_type":"market"'
    j := j + ',"est_entry":' + f_num(estEntry) + ',"stop":' + f_num(stop) + ',"tp":' + f_num(tp)
    j := j + ',"stop_dist_pts":' + f_num(math.abs(estEntry - stop)) + ',"rr":' + str.tostring(tp1RR) + '}'
    alert(j, alert.freq_once_per_bar_close)

// =====================================================================================
//  RISK MANAGEMENT  (state, circuit breakers, gates)
// =====================================================================================
// ---- Open-trade state ----
var int   pendingDir     = 0      // direction of the order just submitted (pre-fill)
var float pendingStop    = na     // stop price captured at signal time
var float pendingQty     = na     // qty submitted at signal time (market order -> filled in full)
var int   pendingBar     = na     // bar the entry was submitted on
var bool  pendingNoScale = false  // Plan B decided from the submitted qty (same rule as noScaleTrade)
var float activeInitStop = na     // finalized initial stop on the fill bar
var float activeTP1      = na     // TP1 price (scale-out)
var float runnerStop     = na     // runner stop (initial -> BE -> trailed)
var float entryQty       = na     // full filled qty (to detect the partial fill)
var bool  tp1Filled      = false  // scaled: TP1 partial filled ; no-scale: 1.5R milestone reached
var bool  noScaleTrade   = false  // Plan B: odd / 1-contract qty -> run the FULL position, no TP1

// ---- Daily / streak state ----
var int   tradesToday    = 0
var int   totalEntries   = 0
var int   tradeCount     = 0      // fully-closed trades (one per entry)
var int   tradeWins      = 0
var int   consecLosses   = 0
// full-trade stats, bucketed by mode and sample: index = (Plan B ? 2 : 0) + (OOS ? 1 : 0)
var int[]   fullN        = array.new_int(4, 0)
var int[]   fullWin      = array.new_int(4, 0)
var float[] fullPnl      = array.new_float(4, 0.0)
var bool  dailyLossHit   = false
var bool  consecHaltHit  = false
var float dayStartEquity = na
var float eqAtEntry      = na

// ---- Per-entry records (for the runner R column; matched by entry_time) ----
var int[]   entryTimeArr = array.new_int()
var float[] riskPtsArr   = array.new_float()
var int[]   dirArr       = array.new_int()

// ---- New-day reset ----
if newDay or na(dayStartEquity)
    dayStartEquity := strategy.equity
    tradesToday    := 0
    dailyLossHit   := false
    consecHaltHit  := false
    consecLosses   := 0

// ---- Trade-outcome tracking (full trade = one entry, incl. its scale-out) ----
// A full trade is over once the book is flat and closedtrades grew since the last count. This
// is count-based rather than a position_size transition, so a trade that fills AND exits on its
// fill bar (possible now that the bracket is placed on the signal bar) is still counted.
// eqAtEntry is captured on the signal bar (flat equity before the trade).
var int closedSeen = 0
if strategy.position_size == 0 and strategy.closedtrades > closedSeen
    closedSeen := strategy.closedtrades
    if not na(eqAtEntry)
        tradeNet = strategy.equity - eqAtEntry
        tradeCount += 1
        if tradeNet > 0
            tradeWins += 1
            consecLosses := 0
        else
            consecLosses += 1
        // bucket the full-trade result by the mode that managed it (decided from the submitted
        // qty) and by IS / OOS (entry time of the trade that just closed)
        bIdx = (pendingNoScale ? 2 : 0) + (strategy.closedtrades.entry_time(strategy.closedtrades - 1) >= oosStart ? 1 : 0)
        array.set(fullN,   bIdx, array.get(fullN,   bIdx) + 1)
        array.set(fullPnl, bIdx, array.get(fullPnl, bIdx) + tradeNet)
        if tradeNet > 0
            array.set(fullWin, bIdx, array.get(fullWin, bIdx) + 1)
        if useConsec and consecLosses >= maxConsec
            consecHaltHit := true
        eqAtEntry := na

// ---- Reset state once the previous trade is over (BEFORE new entries) ----
// Runs ahead of the entry block so a new signal on the same bar keeps its own state and bracket.
// "Over" = flat and either a finalized trade existed, or the submitted entry filled and closed
// within its own fill bar (finalize never ran, activeTP1 still na).
tradeOver = strategy.position_size == 0 and (not na(activeTP1) or (pendingDir != 0 and bar_index > pendingBar))
if tradeOver
    pendingDir     := 0
    pendingStop    := na
    pendingQty     := na
    activeInitStop := na
    activeTP1      := na
    runnerStop     := na
    entryQty       := na
    tp1Filled      := false
    noScaleTrade   := false
    strategy.cancel("TP1")
    strategy.cancel("Init")
    strategy.cancel("Run")
    strategy.cancel("RunB")
    strategy.cancel("Stop")

// ---- Daily-loss circuit breaker (bar-close equity, incl. open P&L) ----
if useDailyLoss and not na(dayStartEquity)
    if (dayStartEquity - strategy.equity) >= dayStartEquity * dailyLossPct / 100.0
        dailyLossHit := true

haltedToday  = dailyLossHit or (useConsec and consecHaltHit)
canEnterBase = inDateRange and sessionOK and entryTimeOK and not haltedToday and tradesToday < maxTradesDay and strategy.position_size == 0

// =====================================================================================
//  EXECUTION
// =====================================================================================
// Risk base (SPEC §8.1): by default the STARTING balance, so the cash risk per trade neither
// compounds with wins nor shrinks with losses.
riskBaseAmt = riskBase == "Fixed Balance" ? fixedBal : riskBase == "Account Equity" ? strategy.equity : strategy.initial_capital

// ---- Entries (with fixed-% sizing) ----
if longSignal and canEnterBase
    stopLvl  = math.min(swingLow - buf, close - syminfo.mintick)   // ensure stop sits below price
    stopDist = close - stopLvl
    if stopDist > 0
        riskCash = riskBaseAmt * riskPercent / 100.0
        rawQty   = riskCash / (stopDist * syminfo.pointvalue)
        qty      = roundUnits ? math.floor(rawQty) : rawQty
        if qty > 0
            estTP1 = close + tp1RR * stopDist
            strategy.entry("Long", strategy.long, qty = qty, comment = "Long")
            // Bracket in the SAME bar as the entry so the fill bar is protected; the fill-bar
            // block below re-prices it from the real fill (same order ids -> modified in place).
            pendingNoScale := roundUnits and (int(math.round(qty)) % 2 == 1)
            if pendingNoScale
                strategy.exit("Stop", from_entry = "Long", stop = stopLvl, comment = "Init stop")
            else
                strategy.exit("TP1",  from_entry = "Long", qty_percent = scaleOutPct,       stop = stopLvl, limit = estTP1, comment = "TP1")
                strategy.exit("Init", from_entry = "Long", qty_percent = 100 - scaleOutPct, stop = stopLvl, comment = "Init stop")
            pendingDir  := 1
            pendingStop := stopLvl
            pendingQty  := qty
            pendingBar  := bar_index
            eqAtEntry   := strategy.equity
            tradesToday  += 1
            totalEntries += 1
            armDir := 0            // require a fresh pullback for the next trade
            f_alert("entry", "long", close, stopLvl, estTP1)

if shortSignal and canEnterBase
    stopLvl  = math.max(swingHigh + buf, close + syminfo.mintick)
    stopDist = stopLvl - close
    if stopDist > 0
        riskCash = riskBaseAmt * riskPercent / 100.0
        rawQty   = riskCash / (stopDist * syminfo.pointvalue)
        qty      = roundUnits ? math.floor(rawQty) : rawQty
        if qty > 0
            estTP1 = close - tp1RR * stopDist
            strategy.entry("Short", strategy.short, qty = qty, comment = "Short")
            pendingNoScale := roundUnits and (int(math.round(qty)) % 2 == 1)
            if pendingNoScale
                strategy.exit("Stop", from_entry = "Short", stop = stopLvl, comment = "Init stop")
            else
                strategy.exit("TP1",  from_entry = "Short", qty_percent = scaleOutPct,       stop = stopLvl, limit = estTP1, comment = "TP1")
                strategy.exit("Init", from_entry = "Short", qty_percent = 100 - scaleOutPct, stop = stopLvl, comment = "Init stop")
            pendingDir  := -1
            pendingStop := stopLvl
            pendingQty  := qty
            pendingBar  := bar_index
            eqAtEntry   := strategy.equity
            tradesToday  += 1
            totalEntries += 1
            armDir := 0
            f_alert("entry", "short", close, stopLvl, estTP1)

// ---- Finalize stop / TP on the fill bar, then manage exits ----
inLong  = strategy.position_size > 0
inShort = strategy.position_size < 0

// LONG
if inLong
    if na(activeTP1)                                   // first bar of the long -> finalize
        avg = strategy.position_avg_price
        activeInitStop := math.min(pendingStop, avg - syminfo.mintick)
        float riskPts = avg - activeInitStop
        activeTP1 := avg + tp1RR * riskPts
        runnerStop := activeInitStop
        // Submitted qty, not the current position: TP1 may already have filled on this bar.
        entryQty := pendingQty
        // PLAN B: an odd / single-contract size cannot be split 50/50 into whole
        // contracts -> skip the scale-out and run the FULL position as the runner.
        noScaleTrade := roundUnits and (int(math.round(entryQty)) % 2 == 1)
        tp1Filled := false
        array.push(entryTimeArr, time)
        array.push(riskPtsArr, riskPts)
        array.push(dirArr, 1)
    prevStopL = tp1Filled ? runnerStop : activeInitStop
    if noScaleTrade
        // -- Plan B: full position runner. Initial stop until 1.5R, then BE + trail. --
        if not tp1Filled and high >= activeTP1
            tp1Filled := true                          // 1.5R reached (no contracts taken off)
        if tp1Filled
            be   = strategy.position_avg_price
            cand = math.max(be, trailLong)
            if runnerStop < be                             // first move: straight to breakeven (or the trail, if higher)
                runnerStop := cand
            else if cand - runnerStop >= trailMinStep      // afterwards: only in steps of >= trailMinStepTicks
                runnerStop := cand
        if not tp1Filled
            strategy.exit("Stop", from_entry = "Long", stop = activeInitStop, comment = "Init stop")
        else
            strategy.cancel("Stop")
            strategy.exit("RunB", from_entry = "Long", stop = runnerStop, comment = "Runner (Plan B)")
    else
        // -- Scaled: 50% off at 1.5R, move remainder to BE, then trail. --
        if not tp1Filled and not na(entryQty) and math.abs(strategy.position_size) < entryQty * 0.95
            tp1Filled := true                          // TP1 partial filled
        if tp1Filled
            be   = strategy.position_avg_price
            cand = math.max(be, trailLong)
            if runnerStop < be                             // first move: straight to breakeven (or the trail, if higher)
                runnerStop := cand
            else if cand - runnerStop >= trailMinStep      // afterwards: only in steps of >= trailMinStepTicks
                runnerStop := cand
        if not tp1Filled
            strategy.exit("TP1",  from_entry = "Long", qty_percent = scaleOutPct,       stop = activeInitStop, limit = activeTP1, comment = "TP1")
            strategy.exit("Init", from_entry = "Long", qty_percent = 100 - scaleOutPct, stop = activeInitStop, comment = "Init stop")
        else
            strategy.cancel("Init")
            strategy.exit("Run", from_entry = "Long", stop = runnerStop, comment = "Runner")
    curStopL = tp1Filled ? runnerStop : activeInitStop
    if curStopL != prevStopL
        f_alert("stop_update", "long", strategy.position_avg_price, curStopL, tp1Filled ? na : activeTP1)

// SHORT
if inShort
    if na(activeTP1)
        avg = strategy.position_avg_price
        activeInitStop := math.max(pendingStop, avg + syminfo.mintick)
        float riskPts = activeInitStop - avg
        activeTP1 := avg - tp1RR * riskPts
        runnerStop := activeInitStop
        entryQty := pendingQty
        noScaleTrade := roundUnits and (int(math.round(entryQty)) % 2 == 1)
        tp1Filled := false
        array.push(entryTimeArr, time)
        array.push(riskPtsArr, riskPts)
        array.push(dirArr, -1)
    prevStopS = tp1Filled ? runnerStop : activeInitStop
    if noScaleTrade
        // -- Plan B: full position runner. Initial stop until 1.5R, then BE + trail. --
        if not tp1Filled and low <= activeTP1
            tp1Filled := true
        if tp1Filled
            be   = strategy.position_avg_price
            cand = math.min(be, trailShort)
            if runnerStop > be                             // first move: straight to breakeven (or the trail, if lower)
                runnerStop := cand
            else if runnerStop - cand >= trailMinStep      // afterwards: only in steps of >= trailMinStepTicks
                runnerStop := cand
        if not tp1Filled
            strategy.exit("Stop", from_entry = "Short", stop = activeInitStop, comment = "Init stop")
        else
            strategy.cancel("Stop")
            strategy.exit("RunB", from_entry = "Short", stop = runnerStop, comment = "Runner (Plan B)")
    else
        // -- Scaled: 50% off at 1.5R, move remainder to BE, then trail. --
        if not tp1Filled and not na(entryQty) and math.abs(strategy.position_size) < entryQty * 0.95
            tp1Filled := true
        if tp1Filled
            be   = strategy.position_avg_price
            cand = math.min(be, trailShort)
            if runnerStop > be                             // first move: straight to breakeven (or the trail, if lower)
                runnerStop := cand
            else if runnerStop - cand >= trailMinStep      // afterwards: only in steps of >= trailMinStepTicks
                runnerStop := cand
        if not tp1Filled
            strategy.exit("TP1",  from_entry = "Short", qty_percent = scaleOutPct,       stop = activeInitStop, limit = activeTP1, comment = "TP1")
            strategy.exit("Init", from_entry = "Short", qty_percent = 100 - scaleOutPct, stop = activeInitStop, comment = "Init stop")
        else
            strategy.cancel("Init")
            strategy.exit("Run", from_entry = "Short", stop = runnerStop, comment = "Runner")
    curStopS = tp1Filled ? runnerStop : activeInitStop
    if curStopS != prevStopS
        f_alert("stop_update", "short", strategy.position_avg_price, curStopS, tp1Filled ? na : activeTP1)

// ---- Forced exits ----
// One reason per bar, always filled at THIS bar's close (immediately = true; on an RTH-only chart
// the next bar's open would be the next session), each with an "exit" alert:
//   - daily-loss breaker hit, when "Force flat when daily loss is hit" is on
//   - session end (session.islastbar also covers half days)
//   - past the backtest End date
flatReason = (useDailyLoss and flatOnDailyLoss and dailyLossHit) ? "Daily loss halt" : (flatAtEnd and ((useSession and curMin >= sEnd) or session.islastbar)) ? "Session end" : time > endDate ? "End of test range" : ""
if flatReason != "" and strategy.position_size != 0
    f_alert("exit", strategy.position_size > 0 ? "long" : "short", close, na, na)
    strategy.close_all(comment = flatReason, immediately = true)

// (State reset after a closed trade now runs BEFORE the entry block — see "Reset state once
// the previous trade is over".)

// =====================================================================================
//  VISUALS
// =====================================================================================
// Value-Area band
pF = plot(showVA ? emaFast : na, "5m EMA fast", color = color.new(color.blue, 0),   linewidth = 1)
pS = plot(showVA ? emaSlow : na, "5m EMA slow", color = color.new(color.purple, 0), linewidth = 1)
fill(pF, pS, color = color.new(color.blue, 90), title = "Value Area")

// 1H EMAs (stepped)
plot(showHtf ? htfFast : na, "1H EMA fast", color = color.new(color.teal, 0),   linewidth = 2)
plot(showHtf ? htfSlow : na, "1H EMA slow", color = color.new(color.orange, 0), linewidth = 2)

// Stop / TP lines while in a position
curStop = strategy.position_size != 0 ? (tp1Filled ? runnerStop : activeInitStop) : na
plot(showLevels ? curStop : na, "Stop / Trail", color = color.new(color.red, 0), style = plot.style_linebr, linewidth = 1)
plot(showLevels and strategy.position_size != 0 and not tp1Filled ? activeTP1 : na, "TP1", color = color.new(color.green, 0), style = plot.style_linebr, linewidth = 1)

// Date-range / OOS shading
bgcolor(showDateViz and not inDateRange       ? color.new(color.gray, 92) : na, title = "Out of date range")
bgcolor(showDateViz and inDateRange and isOOS ? color.new(color.blue, 90) : na, title = "Out-of-sample period")

var bool oosDrawn = false
if showDateViz and isOOS and not oosDrawn
    line.new(bar_index, low, bar_index, high, xloc = xloc.bar_index, extend = extend.both, color = color.new(color.blue, 20), style = line.style_dashed, width = 1)
    label.new(bar_index, high, "OOS ►", style = label.style_label_down, color = color.new(color.blue, 20), textcolor = color.white, size = size.small)
    oosDrawn := true

// 5m reminder
if barstate.islast and timeframe.period != "5"
    label.new(bar_index, high, "⚠ This strategy is built for the 5-minute chart.\nSwitch the timeframe to 5m for correct results.", style = label.style_label_down, color = color.new(color.orange, 0), textcolor = color.black, size = size.normal)

// =====================================================================================
//  PERFORMANCE TABLE  (runner = a position managed in the BE/trail phase, exit id "Run")
// -------------------------------------------------------------------------------------
//   A "true runner" only exists once the 1.5R milestone was reached and the stop was
//   moved to BE/trail (so it can only close at BE or in profit). In SCALED trades that
//   half is 50% of the position; in PLAN B trades it is the FULL position. Trades stopped
//   BEFORE 1.5R close via the "TP1"/"Init"/"Stop" ids and are excluded here. Runner R is
//   measured from ENTRY: long R = (exit-entry)/initialRisk ; short mirrored.
//   "Table scope" filters every figure to All / In-Sample / Out-of-Sample trades (by entry time).
// =====================================================================================
tblPos = tablePos == "Top Right" ? position.top_right : tablePos == "Bottom Left" ? position.bottom_left : tablePos == "Top Left" ? position.top_left : position.bottom_right
tblTxt = tableSize == "Tiny" ? size.tiny : tableSize == "Normal" ? size.normal : tableSize == "Large" ? size.large : size.small

var table perf = table.new(position = tblPos, columns = 3, rows = 8, frame_width = 1, frame_color = color.new(color.gray, 50), border_width = 1, border_color = color.new(color.gray, 70))

if showPerf and barstate.islast
    // Table scope: which sample(s) feed every figure below
    useIS    = tableScope != "Out-of-Sample"
    useOOS   = tableScope != "In-Sample"
    scopeTag = tableScope == "In-Sample" ? " · IS" : tableScope == "Out-of-Sample" ? " · OOS" : ""
    nFullS   = (useIS ? array.get(fullN,   0) : 0)   + (useOOS ? array.get(fullN,   1) : 0)
    winFullS = (useIS ? array.get(fullWin, 0) : 0)   + (useOOS ? array.get(fullWin, 1) : 0)
    pnlFullS = (useIS ? array.get(fullPnl, 0) : 0.0) + (useOOS ? array.get(fullPnl, 1) : 0.0)
    nFullB   = (useIS ? array.get(fullN,   2) : 0)   + (useOOS ? array.get(fullN,   3) : 0)
    winFullB = (useIS ? array.get(fullWin, 2) : 0)   + (useOOS ? array.get(fullWin, 3) : 0)
    pnlFullB = (useIS ? array.get(fullPnl, 2) : 0.0) + (useOOS ? array.get(fullPnl, 3) : 0.0)

    // Runner stats split by exit id: "Run" = scaled half ; "RunB" = Plan B full position
    rTotS = 0
    rWinS = 0
    rRS   = 0.0
    rPnlS = 0.0
    rTotB = 0
    rWinB = 0
    rRB   = 0.0
    rPnlB = 0.0
    nC = strategy.closedtrades
    if nC > 0
        for k = 0 to nC - 1
            xid     = strategy.closedtrades.exit_id(k)
            eTime   = strategy.closedtrades.entry_time(k)
            inScope = (useIS and eTime < oosStart) or (useOOS and eTime >= oosStart)
            isS = xid == "Run"  and inScope
            isB = xid == "RunB" and inScope
            if isS or isB
                p      = strategy.closedtrades.profit(k)
                entryP = strategy.closedtrades.entry_price(k)
                exitP  = strategy.closedtrades.exit_price(k)
                idx = -1
                if array.size(entryTimeArr) > 0
                    for j = 0 to array.size(entryTimeArr) - 1
                        if array.get(entryTimeArr, j) == eTime
                            idx := j
                            break
                float rval = na
                if idx >= 0
                    rp = array.get(riskPtsArr, idx)
                    dr = array.get(dirArr, idx)
                    if rp > 0
                        rval := dr == 1 ? (exitP - entryP) / rp : (entryP - exitP) / rp
                if isS
                    rTotS += 1
                    rPnlS += p
                    if p > 0
                        rWinS += 1
                    if not na(rval)
                        rRS += rval
                else
                    rTotB += 1
                    rPnlB += p
                    if p > 0
                        rWinB += 1
                    if not na(rval)
                        rRB += rval

    fg    = chart.fg_color
    hdrBg = color.new(color.gray, 60)
    posC  = color.new(color.green, 0)
    negC  = color.new(color.red, 0)

    // ---- Scaled column text ----
    sFull  = str.tostring(nFullS)
    sTwin  = nFullS > 0 ? str.tostring(100.0 * winFullS / nFullS, "#.0") + "%" : "—"
    sPnl   = str.tostring(pnlFullS, "#.#")
    sReach = str.tostring(rTotS)
    sRwin  = rTotS > 0 ? str.tostring(100.0 * rWinS / rTotS, "#.0") + "%" : "—"
    sRavg  = rTotS > 0 ? str.tostring(rRS / rTotS, "#.##") + "R" : "—"
    sRpnl  = str.tostring(rPnlS, "#.#")
    // ---- Plan B column text ----
    bFull  = str.tostring(nFullB)
    bTwin  = nFullB > 0 ? str.tostring(100.0 * winFullB / nFullB, "#.0") + "%" : "—"
    bPnl   = str.tostring(pnlFullB, "#.#")
    bReach = str.tostring(rTotB)
    bRwin  = rTotB > 0 ? str.tostring(100.0 * rWinB / rTotB, "#.0") + "%" : "—"
    bRavg  = rTotB > 0 ? str.tostring(rRB / rTotB, "#.##") + "R" : "—"
    bRpnl  = str.tostring(rPnlB, "#.#")

    // ---- Header (top-left shows the active trail method) ----
    table.cell(perf, 0, 0, (trailType == "Chandelier Exit" ? "Chand." : "ATR") + scopeTag, text_color = fg, bgcolor = hdrBg, text_size = tblTxt)
    table.cell(perf, 1, 0, "Scaled", text_color = fg, bgcolor = hdrBg, text_size = tblTxt)
    table.cell(perf, 2, 0, "Plan B", text_color = fg, bgcolor = hdrBg, text_size = tblTxt)

    // ---- Full-trade rows ----
    table.cell(perf, 0, 1, "Full trades", text_color = fg, text_size = tblTxt)
    table.cell(perf, 1, 1, sFull, text_color = fg, text_size = tblTxt)
    table.cell(perf, 2, 1, bFull, text_color = fg, text_size = tblTxt)

    table.cell(perf, 0, 2, "Trade win %", text_color = fg, text_size = tblTxt)
    table.cell(perf, 1, 2, sTwin, text_color = fg, text_size = tblTxt)
    table.cell(perf, 2, 2, bTwin, text_color = fg, text_size = tblTxt)

    table.cell(perf, 0, 3, "Net P&L", text_color = fg, text_size = tblTxt)
    table.cell(perf, 1, 3, sPnl, text_color = pnlFullS > 0 ? posC : pnlFullS < 0 ? negC : fg, text_size = tblTxt)
    table.cell(perf, 2, 3, bPnl, text_color = pnlFullB > 0 ? posC : pnlFullB < 0 ? negC : fg, text_size = tblTxt)

    // ---- Runner-phase rows ----
    table.cell(perf, 0, 4, "Reached 1.5R", text_color = fg, text_size = tblTxt)
    table.cell(perf, 1, 4, sReach, text_color = fg, text_size = tblTxt)
    table.cell(perf, 2, 4, bReach, text_color = fg, text_size = tblTxt)

    table.cell(perf, 0, 5, "Runner win %", text_color = fg, text_size = tblTxt)
    table.cell(perf, 1, 5, sRwin, text_color = rWinS > 0 ? posC : fg, text_size = tblTxt)
    table.cell(perf, 2, 5, bRwin, text_color = rWinB > 0 ? posC : fg, text_size = tblTxt)

    table.cell(perf, 0, 6, "Avg runner R", text_color = fg, text_size = tblTxt)
    table.cell(perf, 1, 6, sRavg, text_color = rRS > 0 ? posC : rRS < 0 ? negC : fg, text_size = tblTxt)
    table.cell(perf, 2, 6, bRavg, text_color = rRB > 0 ? posC : rRB < 0 ? negC : fg, text_size = tblTxt)

    table.cell(perf, 0, 7, "Runner P&L", text_color = fg, text_size = tblTxt)
    table.cell(perf, 1, 7, sRpnl, text_color = rPnlS > 0 ? posC : rPnlS < 0 ? negC : fg, text_size = tblTxt)
    table.cell(perf, 2, 7, bRpnl, text_color = rPnlB > 0 ? posC : rPnlB < 0 ? negC : fg, text_size = tblTxt)
