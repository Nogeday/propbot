# systemd unit for the PropBot signal bot (TradingView webhook -> Telegram; never places orders).
# Install: docs/runbook.md §4. Copy to /etc/systemd/system/propbot.service and adjust the four
# marked lines if the checkout is not in /opt/propbot or the service user is not "propbot".
[Unit]
Description=PropBot signal bot (TradingView webhook -> Telegram, no orders)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# --- adjust these four lines to your install ---
User=propbot
WorkingDirectory=/opt/propbot
ExecStart=/opt/propbot/.venv/bin/propbot serve --mode signal --venue ftmo_2step_100k
# The only directory the service may write to (database and lock file): <checkout>/data.
# It must exist, or the service cannot start (status=226/NAMESPACE).
ReadWritePaths=/opt/propbot/data
# ------------------------------------------------
# A crashed background task makes the process exit non-zero; systemd brings it back.
# The queue and the Telegram outbox live in data/propbot.db and are picked up again.
Restart=always
RestartSec=5
TimeoutStopSec=20
# Files the bot creates (the database) are readable by the service user only.
UMask=0077
# Hardening. The bot needs the network, its own checkout (read) and data/ (write), nothing else.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
# ProtectHome=true hides /home from the service. Uncomment it only when NEITHER the checkout
# NOR the Python interpreter is under /home; check the interpreter with
#   readlink -f /opt/propbot/.venv/bin/python
# Where the system has no Python 3.12 (Ubuntu 22.04) uv installs one under
# ~/.local/share/uv/python: with ProtectHome the service could not start (status=203/EXEC).
# ProtectHome=true

[Install]
WantedBy=multi-user.target
