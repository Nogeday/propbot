# Secrets for PropBot. Copy and lock down before filling in:
#   cp .env.example .env && chmod 600 .env
# The bot refuses to start while .env is readable by group or others. Never commit .env.
# Only these four keys are read; real environment variables override this file.
# A broker or prop-firm password does not belong here or anywhere else in Python.

# Bot token from @BotFather: <digits>:<key>.
TELEGRAM_BOT_TOKEN=
# Your own private chat id, a positive integer (docs/runbook.md 3.1). Group and channel ids
# are negative and are refused: signals go to one person only.
TELEGRAM_ALLOWED_CHAT_ID=
# Random value that authenticates TradingView webhooks (not a login credential).
# 32-128 characters out of A-Z a-z 0-9 - _ ; generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# The same value goes into the "Webhook token" input of every Pine script.
TV_WEBHOOK_TOKEN=
# 6-12 digits. Confirms /kill and /devam <PIN> in Telegram (later also the live-mode unlock).
PROPBOT_PIN=
